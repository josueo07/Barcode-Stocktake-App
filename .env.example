# Copy this file to server/.env and adjust as needed.
# See client/.env.example for frontend-specific variables.

# Port the Express + Socket.io server listens on.
PORT=4000

# Path to the SQLite database file (relative to server/).
DATABASE_PATH=./data/stocktake.sqlite

# Origin(s) allowed to call the API / connect via WebSocket, comma-separated.
# When testing from your phone, this must include your PC's LAN address, e.g.:
# http://localhost:5173,http://192.168.1.42:5173
CLIENT_ORIGIN=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time zone for dates in exported reports (IANA name).
STORE_TIMEZONE=America/Puerto_Rico
